{
    "name": "thoule/push",
    "description": "Web-Push fuer die Thoule-Laravel-Apps: Transport-Contract, Minishlink-Transport, Test-Transport, Abo-Model mit Ablaufbehandlung und Aufraeum-Kommando",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "minishlink/web-push": "^10.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Thoule\\Push\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thoule\\Push\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thoule\\Push\\PushServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
